{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "final_space": false,
    "console_title_template": "{{ .Shell }} in {{ .Folder }}",
    "palette": {
        "base": "#faf4ed",
        "surface": "#fffaf3",
        "overlay": "#f2e9e1",
        "muted": "#9893a5",
        "subtle": "#797593",
        "text": "#575279",
        "love": "#b4637a",
        "gold": "#ea9d34",
        "rose": "#d7827e",
        "pine": "#286983",
        "foam": "#56949f",
        "iris": "#907aa9",
        "highlight-low": "#f4ede8",
        "highlight-med": "#dfdad9",
        "highlight-high": "#cecacd",

        "main": "p:iris",
        "time": "p:muted",
        "path": "p:main",
        "git": "p:gold",

        "docker": "p:foam",
        "go": "p:foam",
        "haskell": "p:iris",
        "lua": "p:pine",
        "python": "p:gold",
        "rust": "p:rose",
        "npm": "p:love",
        "pnpm": "p:gold",
        "astro": "p:iris"
    },
    "transient_prompt": {
        "foreground": "p:time",
        "template": "  [{{ now | date \"15:04:05\" }}] "
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "path",
                    "style": "plain",
                    "foreground": "p:path",
                    "template": "{{ .Path }} ",
                    "options": {
                        "home_icon": "~",
                        "folder_icon": "..",
                        "style": "agnoster_short"
                    }
                },
                {
                    "type": "git",
                    "style": "plain",
                    "foreground": "p:git",
                    "template": "[{{ .HEAD }}] ",
                    "options": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": false,
                        "fetch_upstream_icon": false,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    }
                },
                {
                    "type": "docker",
                    "style": "plain",
                    "foreground": "p:docker",
                    "template": "[\uf308 {{ .Context }}] "
                },
                {
                    "type": "go",
                    "style": "plain",
                    "foreground": "p:go",
                    "template": "[\ue627 go] "
                },
                {
                    "type": "haskell",
                    "style": "plain",
                    "foreground": "p:haskell",
                    "template": "[\ue61f hskl] "
                },
                {
                    "type": "lua",
                    "style": "plain",
                    "foreground": "p:lua",
                    "template": "[\ue620 lua] "
                },
                {
                    "type": "python",
                    "style": "plain",
                    "foreground": "p:python",
                    "template": "[\ue73c pytn] ",
                    "options": {
                        "display_default": false,
                        "display_mode": "context"
                    }
                },
                {
                    "type": "rust",
                    "style": "plain",
                    "foreground": "p:rust",
                    "template": "[\ue7a8 rs] "
                },
                {
                    "type": "npm",
                    "style": "plain",
                    "foreground": "p:npm",
                    "template": "{{ if not (glob \"pnpm-lock.yaml\") }} [\ue71e npm] {{ end }}"
                },
                {
                    "type": "pnpm",
                    "style": "plain",
                    "foreground": "p:pnpm",
                    "template": "[\ue865 pnpm] "
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "shell",
                    "style": "plain",
                    "background": "p:main",
                    "foreground": "p:base",
                    "template": " {{ .Name }} "
                },
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "p:main",
                    "template": "\ue0b0 ",
                    "options": {
                        "always_enabled": true
                    }
                }
            ]
        }
    ]
}
